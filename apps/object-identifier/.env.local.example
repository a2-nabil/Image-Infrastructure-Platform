# Same-origin path (recommended). Next.js rewrites this to IMAGE_API_ORIGIN.
NEXT_PUBLIC_IMAGE_API_URL=/api/v1

# Where /api/v1/* is proxied (local Go API or Render).
IMAGE_API_ORIGIN=http://localhost:8080

# Required for object identification
GEMINI_API_KEY=

# Google Identity (public client ID only — never put client_secret in the frontend)
# Add http://localhost:3000 to Google Cloud Console authorized JavaScript origins for local dev.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
