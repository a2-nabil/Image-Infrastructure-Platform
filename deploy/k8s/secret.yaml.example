apiVersion: v1
kind: Secret
metadata:
  name: image-api-secrets
  labels:
    app: image-api
type: Opaque
stringData:
  # Replace placeholders before applying (do not commit real secrets).
  POSTGRES_URL: "postgres://image_platform:CHANGE_ME@postgres:5432/image_platform?sslmode=require"
  REDIS_ADDR: "redis:6379"
  JWT_SECRET: "CHANGE_ME_JWT_SECRET"
  AWS_ACCESS_KEY_ID: "CHANGE_ME_AWS_ACCESS_KEY_ID"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME_AWS_SECRET_ACCESS_KEY"
  # App-compatible keys derived from the values above
  POSTGRES_HOST: "postgres"
  POSTGRES_PORT: "5432"
  POSTGRES_USER: "image_platform"
  POSTGRES_PASSWORD: "CHANGE_ME"
  POSTGRES_DB: "image_platform"
  REDIS_URL: "redis://redis:6379/0"
  GOOGLE_CLIENT_ID: ""
  CDN_BASE_URL: ""
