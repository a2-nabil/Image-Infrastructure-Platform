# Application
APP_ENV=development
PORT=8080
SERVER_BASE_URL=http://localhost:8080
CDN_BASE_URL=
LOG_LEVEL=info
# Comma-separated. Required when APP_ENV is staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Auto-migrate on boot (default true only in development)
MIGRATE_ON_START=true

# PostgreSQL (aligned with infra/docker/docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_platform_dev
POSTGRES_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS (use dedicated development credentials only — never commit real secrets)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DEV_BUCKET=

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
