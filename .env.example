# Application
APP_ENV=development
PORT=8080
SERVER_BASE_URL=http://localhost:8080
CDN_BASE_URL=
LOG_LEVEL=info
# Comma-separated. Required when APP_ENV is staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Auto-migrate on boot (default true only in development)
MIGRATE_ON_START=true

# PostgreSQL (aligned with infra/docker/docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_platform_dev
POSTGRES_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS (local/dev: static keys. staging/prod on EKS: leave keys empty and use IRSA)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_DEV_BUCKET=
# Force static keys even in staging/prod (default false). Development always requires keys.
AWS_USE_STATIC_CREDENTIALS=false
# Issue time-limited S3 GET URLs after ownership checks (default false for local proxy mode)
AWS_S3_PRESIGN_URLS=false
AWS_S3_PRESIGN_TTL_SECONDS=900

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
