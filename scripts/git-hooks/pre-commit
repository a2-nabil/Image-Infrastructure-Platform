#!/usr/bin/env bash
# Fallback pre-commit when Python pre-commit is not installed.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

resolve_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
    return 0
  fi
  if [[ -x "${ROOT}/.tools/gitleaks.exe" ]]; then
    echo "${ROOT}/.tools/gitleaks.exe"
    return 0
  fi
  if [[ -x "${ROOT}/.tools/gitleaks" ]]; then
    echo "${ROOT}/.tools/gitleaks"
    return 0
  fi
  if [[ -x "${ROOT}/scripts/ensure-gitleaks.sh" ]]; then
    bash "${ROOT}/scripts/ensure-gitleaks.sh"
    return 0
  fi
  return 1
}

echo "[pre-commit] scanning for secrets..."
GITLEAKS_BIN=""
if GITLEAKS_BIN="$(resolve_gitleaks)"; then
  "$GITLEAKS_BIN" protect --staged --config .gitleaks.toml --verbose
elif command -v docker >/dev/null 2>&1; then
  # Prefer Windows-style bind mount so Docker Desktop can resolve paths with spaces.
  MOUNT_SRC="$ROOT"
  if command -v cygpath >/dev/null 2>&1; then
    MOUNT_SRC="$(cygpath -w "$ROOT")"
  fi
  err_file="$(mktemp)"
  if ! docker run --rm \
      --mount "type=bind,source=${MOUNT_SRC},target=/repo" \
      -w /repo \
      zricethezav/gitleaks:v8.24.2 \
      protect --staged --config .gitleaks.toml --verbose 2>"$err_file"; then
    echo "[pre-commit] WARN: docker gitleaks failed; install native gitleaks or add the project folder in Docker Desktop → Settings → Resources → File Sharing."
    echo "[pre-commit] tip: bash scripts/ensure-gitleaks.sh"
    sed -n '1,8p' "$err_file" 2>/dev/null || true
  fi
  rm -f "$err_file"
else
  echo "[pre-commit] WARN: gitleaks not found; skipping secret scan (CI will scan)"
  echo "[pre-commit] tip: bash scripts/ensure-gitleaks.sh"
fi

# Lightweight local guard for common secret patterns in staged files
if git diff --cached --name-only --diff-filter=ACM | grep -E '\.(env|pem|key)$' >/dev/null 2>&1; then
  echo "[pre-commit] ERROR: refusing to commit env/key files"
  git diff --cached --name-only --diff-filter=ACM | grep -E '\.(env|pem|key)$' || true
  exit 1
fi

STAGED_GO="$(git diff --cached --name-only --diff-filter=ACM | grep '^services/api/.*\.go$' || true)"
if [[ -n "$STAGED_GO" ]]; then
  echo "[pre-commit] gofmt + go vet..."
  (
    cd services/api
    files="$(echo "$STAGED_GO" | sed 's|^services/api/||')"
    # shellcheck disable=SC2086
    unformatted="$(gofmt -l $files)"
    if [[ -n "$unformatted" ]]; then
      echo "gofmt required for:"
      echo "$unformatted"
      exit 1
    fi
    go vet ./...
  )
fi

STAGED_FE="$(git diff --cached --name-only --diff-filter=ACM | grep '^apps/web/.*\.\(ts\|tsx\|js\|jsx\|mjs\)$' || true)"
if [[ -n "$STAGED_FE" ]]; then
  echo "[pre-commit] frontend lint..."
  (cd apps/web && npm run lint)
fi

echo "[pre-commit] ok"
